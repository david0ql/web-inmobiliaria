# En desarrollo Vite hace de proxy hacia la API: no hace falta URL absoluta.
# Apunta aqui si la API corre en otra maquina.
#
# Se proxyean DOS rutas: /api/v1 (los endpoints) y /media (las fotos del
# inventario, que son estaticos servidos desde uploads/ y quedan fuera del
# prefijo de la API). Sin la segunda no se ve ninguna imagen.
VITE_API_TARGET=http://localhost:3000
